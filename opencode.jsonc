{
  // Config base do modo moneymaker. Agents em `agents/*.md` sao descobertos automaticamente.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "moneymaker",
  "permission": {
    "external_directory": "deny",
    "bash": {
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * --delete*": "deny",
      "rm -rf*": "deny"
    }
  },
  "mcp": {
    "servers": {}
    // Opcao A mantida (sem trigger global).
    // Se trends-research precisar browser para TikTok/Meta scraping:
    // adicione "trends-browser": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-browser"] }
    // ou configure seu server stdio customizado. Opcional — so se scraping publico nao bastar.
  }
}