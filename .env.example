# Variáveis de ambiente — opencode-modo-money (Fase 10 Trends)
# Copie para .env e preencha. NUNCA commite .env com valores reais.

# OpenCode telemetria (opcional)
ANONYMIZED_TELEMETRY=false

# === FASE 10 TRENDS — Credenciais opcionais ===
# Sem estas, fetch-trends roda com fallback vazio + aviso no log

# TikTok Creative Center API Key (para hashtags virais completas)
# Obtenha em: TikTok Ads Manager -> Creative Center -> API
TIKTOK_CREATIVE_CENTER_KEY=

# Meta Graph API Access Token (para tópicos Facebook/Instagram)
# Obtenha em: Meta for Developers -> Graph API Explorer -> Get Token
# Requer app aprovado + permissoes: pages_read_engagement, pages_show_list, instagram_basic
META_ACCESS_TOKEN=

# === FASE 9 MONEY (existentes) ===
# Adicione aqui chaves de APIs de mercado se necessario (BCB, CVM, etc. sao publicas)
# B3_API_KEY=
# CVM_API_KEY=