# .env.example — Modo Moneymaker (nunca commitar .env; sem segredo real aqui)

# Cotacao educacional (opcional, so leitura):
ALPHA_VANTAGE_KEY=
# ALPHA_VANTAGE_KEY: chave gratuita de leitura p/ cotacoes educacionais. Obter em alphavantage.co. Nunca commitar valor.

# Exchange (opcional, SOMENTE chave de leitura, sem permissao de trade/saque):
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_*: criar chave read-only no painel da exchange (desmarcar spot/trade/withdraw). Qualquer permissao de escrita = REPROVAR.

# Telemetria/privacidade:
ANONYMIZED_TELEMETRY=false
